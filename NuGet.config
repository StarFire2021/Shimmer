<?xml version="1.0" encoding="utf-8"?>
<!-- Ensures restore can reach nuget.org for the .NET runtime packs that a
     self-contained publish needs. <clear/> drops any machine-level offline-only
     sources for builds of THIS repo, so publishing works regardless of how the
     machine's global NuGet is configured. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
