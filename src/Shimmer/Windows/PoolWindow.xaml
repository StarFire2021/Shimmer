<Window x:Class="Shimmer.Windows.PoolWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pool"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Manual"
        UseLayoutRounding="True"
        Topmost="False">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar: drag to move, chevron toggles hide-until-hover. -->
        <Border x:Name="TitleBar" Grid.Row="0" Height="34"
                Background="#CC1E2130" CornerRadius="8,8,0,0"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem x:Name="RollMenuItem" Header="Roll up"
                              IsCheckable="True" Click="Roll_Click" />
                    <MenuItem x:Name="AutoHideMenuItem" Header="Hide until hover"
                              IsCheckable="True" Click="AutoHide_Click" />
                    <Separator />
                    <MenuItem Header="Appearance…" Click="Appearance_Click" />
                    <MenuItem Header="Rename…" Click="Rename_Click" />
                    <MenuItem Header="Delete pool" Click="Delete_Click" />
                </ContextMenu>
            </Border.ContextMenu>

            <Grid Margin="10,0,6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TitleText" Grid.Column="0" Text="Pool"
                           Foreground="#F0F3F8" FontSize="13" FontWeight="SemiBold"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="RollButton" Content="▾"
                            Width="24" Height="24" Foreground="#F0F3F8"
                            Background="Transparent" BorderThickness="0"
                            FontSize="12" Cursor="Hand" ToolTip="Roll up"
                            Click="Roll_Click" />
                    <Button x:Name="AutoHideButton" Content="⭳"
                            Width="24" Height="24" Foreground="#F0F3F8"
                            Background="Transparent" BorderThickness="0"
                            FontSize="12" Cursor="Hand" ToolTip="Hide until hover"
                            Click="AutoHide_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="BodyHost" Grid.Row="1">
            <!-- Tinted container; holds our own tiles. Background is set in code
                 from the pool color + opacity. Accepts item drops. -->
            <Border x:Name="Body" CornerRadius="0,0,10,10"
                    AllowDrop="True" Drop="Body_Drop" DragOver="Body_DragOver">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6"
                              Background="Transparent">
                    <WrapPanel x:Name="Tiles" />
                </ScrollViewer>
            </Border>

            <Thumb x:Name="ResizeRight" Width="6"
                   HorizontalAlignment="Right" VerticalAlignment="Stretch"
                   Cursor="SizeWE" Opacity="0"
                   DragDelta="ResizeRight_DragDelta" DragCompleted="Resize_Completed" />
            <Thumb x:Name="ResizeBottom" Height="6"
                   HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                   Cursor="SizeNS" Opacity="0"
                   DragDelta="ResizeBottom_DragDelta" DragCompleted="Resize_Completed" />
            <Thumb x:Name="ResizeCorner" Width="14" Height="14"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Cursor="SizeNWSE" Opacity="0"
                   DragDelta="ResizeCorner_DragDelta" DragCompleted="Resize_Completed" />
        </Grid>
    </Grid>
</Window>
