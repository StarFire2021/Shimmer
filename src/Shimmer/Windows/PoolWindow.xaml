<Window x:Class="Shimmer.Windows.PoolWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pool"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Manual"
        UseLayoutRounding="True"
        Topmost="False">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar: drag to move, chevron toggles hide-until-hover. -->
        <Border x:Name="TitleBar" Grid.Row="0" Height="34"
                Background="#CC1E2130" CornerRadius="8,8,0,0"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Border.ContextMenu>
                <ContextMenu Opened="Menu_Opened" Closed="Menu_Closed">
                    <MenuItem x:Name="RollMenuItem" Header="Roll up"
                              IsCheckable="True" Click="Roll_Click" />
                    <MenuItem x:Name="AutoHideMenuItem" Header="Hide until hover"
                              IsCheckable="True" Click="AutoHide_Click" />
                    <MenuItem x:Name="AutoSnapMenuItem" Header="Auto-size to icon grid"
                              IsCheckable="True" Click="AutoSnap_Click" />
                    <MenuItem x:Name="MagneticSnapMenuItem" Header="Snap edges to even padding"
                              IsCheckable="True" Click="MagneticSnap_Click" />
                    <Separator />
                    <MenuItem x:Name="SortMenu" Header="Sort by">
                        <MenuItem Header="Manual (drag to arrange)" Tag="Manual" IsCheckable="True" Click="Sort_Click" />
                        <MenuItem Header="Name" Tag="Name" IsCheckable="True" Click="Sort_Click" />
                        <MenuItem Header="Type" Tag="Type" IsCheckable="True" Click="Sort_Click" />
                        <MenuItem Header="Date modified" Tag="DateModified" IsCheckable="True" Click="Sort_Click" />
                        <MenuItem Header="Recently used" Tag="RecentlyUsed" IsCheckable="True" Click="Sort_Click" />
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="Appearance…" Click="Appearance_Click" />
                    <MenuItem Header="Rename…" Click="Rename_Click" />
                    <MenuItem Header="Delete pool" Click="Delete_Click" />
                </ContextMenu>
            </Border.ContextMenu>

            <Grid Margin="14,0,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TitleText" Grid.Column="0" Text="Pool"
                           Foreground="#F0F3F8" FontSize="13" FontWeight="SemiBold"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="RollButton" Content="▾"
                            Width="24" Height="24" Foreground="#F0F3F8"
                            Background="Transparent" BorderThickness="0"
                            FontSize="12" Cursor="Hand" ToolTip="Roll up"
                            Click="Roll_Click" />
                    <Button x:Name="AutoHideButton" Content="⭳"
                            Width="24" Height="24" Foreground="#F0F3F8"
                            Background="Transparent" BorderThickness="0"
                            FontSize="12" Cursor="Hand" ToolTip="Hide until hover"
                            Click="AutoHide_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="BodyHost" Grid.Row="1">
            <!-- Tinted container; holds our own tiles. Background is set in code
                 from the pool color + opacity. Accepts item drops. -->
            <Border x:Name="Body" CornerRadius="0,0,10,10"
                    AllowDrop="True" Drop="Body_Drop" DragOver="Body_DragOver">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6"
                              Background="Transparent">
                    <WrapPanel x:Name="Tiles" />
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Resize grips overlay the whole window (both rows) so every edge and
             corner can resize. Transparent; only the cursor shows. Tag encodes
             which edges each grip controls (L/R/T/B). -->
        <Thumb Grid.RowSpan="2" Tag="L" Width="7" HorizontalAlignment="Left" VerticalAlignment="Stretch"
               Cursor="SizeWE" Opacity="0" DragDelta="Resize_DragDelta" DragCompleted="Resize_DragCompleted" />
        <Thumb Grid.RowSpan="2" Tag="R" Width="7" HorizontalAlignment="Right" VerticalAlignment="Stretch"
               Cursor="SizeWE" Opacity="0" DragDelta="Resize_DragDelta" DragCompleted="Resize_DragCompleted" />
        <Thumb Grid.RowSpan="2" Tag="T" Height="7" HorizontalAlignment="Stretch" VerticalAlignment="Top"
               Cursor="SizeNS" Opacity="0" DragDelta="Resize_DragDelta" DragCompleted="Resize_DragCompleted" />
        <Thumb Grid.RowSpan="2" Tag="B" Height="7" HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
               Cursor="SizeNS" Opacity="0" DragDelta="Resize_DragDelta" DragCompleted="Resize_DragCompleted" />
        <Thumb Grid.RowSpan="2" Tag="TL" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Top"
               Cursor="SizeNWSE" Opacity="0" DragDelta="Resize_DragDelta" DragCompleted="Resize_DragCompleted" />
        <Thumb Grid.RowSpan="2" Tag="TR" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Top"
               Cursor="SizeNESW" Opacity="0" DragDelta="Resize_DragDelta" DragCompleted="Resize_DragCompleted" />
        <Thumb Grid.RowSpan="2" Tag="BL" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Bottom"
               Cursor="SizeNESW" Opacity="0" DragDelta="Resize_DragDelta" DragCompleted="Resize_DragCompleted" />
        <Thumb Grid.RowSpan="2" Tag="BR" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom"
               Cursor="SizeNWSE" Opacity="0" DragDelta="Resize_DragDelta" DragCompleted="Resize_DragCompleted" />
    </Grid>
</Window>
